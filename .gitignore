# OS
.DS_Store
**/.DS_Store
Thumbs.db
Desktop.ini

# MCP config may contain API keys — use .cursor/mcp.json.example as template
.cursor/mcp.json
.cursor/tools/
.cursor/stitch.env

# Stitch downloaded screen HTML/PNG (regenerate via MCP)
.stitch/designs/

# Flutter / Dart
**/.dart_tool/
**/.packages
**/build/
**/*.iml
.idea/
.vscode/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# Melos
**/.melos_tool/

# Coverage and logs
coverage/
**/*.lcov
*.log
logs/

# Android
**/local.properties
**/.gradle/
**/captures/
**/*.apk
**/*.aab
**/*.jks
**/*.keystore
**/key.properties

# iOS / signing (not currently a target; keep secrets out)
**/Pods/
**/.symlinks/
*.pem
*.p12
*.mobileprovision
*.p8

# Firebase — keep the example; never commit a live google-services.json
**/google-services.json
!**/google-services.json.example
**/GoogleService-Info.plist

# Archives
*.zip

# Local context-mode index (not source)
.github/context-mode/

# Environment — keep committed examples
.env
.env.*
!.env.example
!**/*.env.example
