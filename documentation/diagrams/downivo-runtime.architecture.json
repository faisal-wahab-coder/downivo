  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "A share or typed URL enters the Flutter UI",
        "DownloadManager resolves, then Dio fetches",
        "At most three downloads run at once"
      ]
    },
    {
      "dot": "emerald",
      "title": "On device",
      "items": [
        "sqflite stores downloads and app_metadata",
        "FileStore writes category folders on device",
        "tasksStream is the live queue bus"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust",
      "items": [
        "Remote hosts stay outside the app",
        "There is no account server and no sync",
        "The foreground service is another isolate"
      ]
    }
