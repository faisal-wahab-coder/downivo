# UniversalDownloader / Downivo — environment template
#
# The Flutter apps do not load this file at runtime.
# Copy values into the matching local files or pass them as --dart-define.
# Never commit real credentials.

# --- Analytics (optional) ----------------------------------------------------
# Passed at run/build time, not read from .env:
#   flutter run --dart-define=POSTHOG_API_KEY= --dart-define=POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Firebase (optional) -----------------------------------------------------
# Copy google-services.json from the Firebase console into:
#   downivo/apps/mobile/android/app/google-services.json
# Use downivo/apps/mobile/android/app/google-services.json.example as a stub.
# Crashlytics stays disabled until that file exists.

# --- Android release signing (optional) --------------------------------------
# Copy downivo/apps/mobile/android/key.properties.example → key.properties
# and fill storePassword / keyPassword / keyAlias / storeFile locally.

# --- Flutter Web CORS proxy (optional) ---------------------------------------
# Used by downivo/apps/web/tool/cors_proxy.dart (loopback only).
UD_WEB_PROXY_PORT=8787

# --- Cursor / Stitch tooling (maintainers only) ------------------------------
# Copy .cursor/stitch.env.example → .cursor/stitch.env
STITCH_API_KEY=
