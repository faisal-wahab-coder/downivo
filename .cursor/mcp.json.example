{
  "mcpServers": {
    "context-mode": {
      "command": "/Users/user/.nvm/versions/node/v20.20.2/bin/node",
      "args": [
        "/ABSOLUTE/PATH/TO/Universal Download Manager/.cursor/tools/node_modules/context-mode/cli.bundle.mjs"
      ]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_CONTEXT7_API_KEY"
      }
    },
    "stitch": {
      "command": "/bin/bash",
      "args": [
        "/ABSOLUTE/PATH/TO/Universal Download Manager/.cursor/tools/stitch-proxy.sh"
      ]
    }
  }
}
